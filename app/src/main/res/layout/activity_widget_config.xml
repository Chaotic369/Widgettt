<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#000000" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical" xmlns:android="[http://schemas.android.com/apk/res/android](http://schemas.android.com/apk/res/android)">
<LinearLayout android:background="#05081B" android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="14dp">
<TextView android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="Widget Designer" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
<Button android:backgroundTint="#A855F7" android:id="@+id/btnSaveWidget" android:layout_height="40dp" android:layout_width="wrap_content" android:text="Apply to Home Screen" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold"/>
</LinearLayout>
<com.custom.textwidget.ui.components.LiveWidgetPreview
android:id="@+id/liveWidgetPreview"
android:layout_width="match_parent"
android:layout_height="190dp"
android:layout_margin="12dp" />
<ScrollView android:layout_height="0dp" android:layout_weight="1" android:layout_width="match_parent" android:paddingBottom="24dp" android:paddingHorizontal="12dp">
<LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical">
<EditText android:background="#080B20" android:gravity="top|start" android:hint="Enter custom widget text..." android:id="@+id/inputWidgetText" android:inputType="textMultiLine" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:minLines="2" android:padding="14dp" android:textColor="#FFFFFF" android:textColorHint="#64748B" android:textSize="15sp"/>
<com.custom.textwidget.ui.components.FontPickerPanel
android:id="@+id/fontPickerPanel"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="12dp" />
<com.custom.textwidget.ui.components.ShapeAndBorderControls
android:id="@+id/shapeAndBorderControls"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="12dp" />
<com.custom.textwidget.ui.components.ColorAlphaSliders
android:id="@+id/colorAlphaSliders"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="12dp" />
<com.custom.textwidget.ui.components.PositionAndPaddingControls
android:id="@+id/positionAndPaddingControls"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="20dp" />
</LinearLayout>
</ScrollView>
</LinearLayout>
